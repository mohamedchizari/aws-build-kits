# Kit A settings. Copy to config.env and edit:   cp config.example.env config.env
# Environment variables with the same names win over this file. So an AWS_REGION or KIT_PREFIX exported in
# your shell overrides the value here. 10_deploy.py records the Region, prefix and account of the deploy in
# .state.json, and every later script stops if the shell points somewhere else.
# No secrets belong here. There is no account id of yours in this file and none is needed.

# Region for everything. Prices in this kit were read for us-east-1 only (README section 2).
AWS_REGION=us-east-1

# Every resource name starts with this, then "-kita-". Lower-case letters, digits, hyphens; at most 20 characters.
KIT_PREFIX=kitdemo

# NAME (not ARN) of the IAM role SageMaker assumes to pull the image and write logs.
# You create it once (README section 3, step 4). The scripts look up its ARN.
SAGEMAKER_EXECUTION_ROLE_NAME=kitdemo-kita-sagemaker-execution

# One GPU instance. Known to this kit, us-east-1 real-time hosting price per hour and quota code
# (AWS Price List file published 2026-10-06 and AWS quotas page, both read 2026-10-07):
#   ml.g6.xlarge   $1.1267  L-D470D954   1 x NVIDIA L4,   4 vCPU, 16 GiB RAM
#   ml.g6.2xlarge  $1.222   L-98BDE811   1 x NVIDIA L4,   8 vCPU, 32 GiB RAM   (default)
#   ml.g5.xlarge   $1.408   L-1928E07B   1 x NVIDIA A10G, 4 vCPU, 16 GiB RAM
#   ml.g5.2xlarge  $1.515   L-9614C779   1 x NVIDIA A10G, 8 vCPU, 32 GiB RAM
# Your quota request must name the same instance type you put here.
INSTANCE_TYPE=ml.g6.2xlarge

# Open-weights model on Hugging Face. Must not be gated: this kit sends no Hugging Face token.
# Qwen/Qwen3-4B: Apache-2.0, not gated, 4.02 billion parameters (model page read 2026-10-07).
HF_MODEL_ID=Qwen/Qwen3-4B

# AWS's public Deep Learning Containers registry account for commercial Regions. It is AWS's account, not yours.
# https://aws.github.io/deep-learning-containers/reference/available_images/ (read 2026-10-07)
DLC_REGISTRY_ACCOUNT=763104351884

# Tag of the AWS vLLM container for SageMaker, from the same page (newest listed on 2026-10-07).
# The AWS documentation example for this model uses the older 0.20.2-gpu-py312-cu130-ubuntu22.04-sagemaker
# with INFERENCE_AMI_VERSION empty; that pair is the first fallback (README section 2).
VLLM_IMAGE_TAG=0.30.0-gpu-py312-cu130-ubuntu24.04-sagemaker

# Host AMI for the GPU instance. The image is CUDA 13.0; this value is the CUDA 13.0 AMI in the SageMaker
# API reference. AWS sources disagree on which value to use (README section 2).
INFERENCE_AMI_VERSION=al2023-ami-sagemaker-inference-gpu-4-1

# vLLM settings for the first deployment (the baseline you measure before changing one of them).
# Longest prompt plus answer, in tokens. Becomes SM_VLLM_MAX_MODEL_LEN.
MAX_MODEL_LEN=8192
# How many requests vLLM decodes in one batch. Becomes SM_VLLM_MAX_NUM_SEQS. Kept low on purpose so that
# the load test at concurrency 16 shows queueing, and raising it in step 70 shows batching.
MAX_NUM_SEQS=4
# Share of GPU memory vLLM may take, for example 0.90. Empty means the container's default.
GPU_MEMORY_UTILIZATION=

# Seconds SageMaker waits for the container to become healthy (60 to 3600). The container downloads
# about 8 GB of weights before it is healthy.
STARTUP_HEALTH_CHECK_TIMEOUT_SECONDS=900

# How long you intend to keep the endpoint, in hours. Recorded as a deadline at deploy; later scripts
# refuse to run past it. It deletes nothing by itself.
MAX_HOURS=3

# Extra chat-template arguments sent with every request, as JSON. Qwen3 "thinks" before answering unless
# told not to; this turns that off so answers are short and plain. Empty sends nothing.
CHAT_TEMPLATE_KWARGS_JSON={"enable_thinking": false}
