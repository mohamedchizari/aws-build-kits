# Copy this file to config.env and edit it. config.env is git-ignored.
# Real environment variables win over config.env. No secrets belong here:
# AWS credentials come from your normal AWS profile or SSO session, never from this file.

# Region. us-east-1 is where the prices in this kit were read.
# CAREFUL: an AWS_REGION exported in your shell overrides this line. Many setups export one.
# Check with `echo $AWS_REGION`. The scripts compare the Region, the prefix and the account
# with what .state.json recorded at deploy time and stop if one differs.
AWS_REGION=us-east-1

# Every resource name starts with this. 3 to 16 characters: lower-case letters, digits, single hyphens.
# Do not change it while something is deployed: tear down first.
KIT_PREFIX=kitdemo

# managed   = Bedrock Managed Knowledge Base. No vector store in your account. Default.
# s3vectors = customer-managed knowledge base on Amazon S3 Vectors. Fallback if the managed
#             type gives you trouble. Adds an embedding model, a vector bucket and an index.
# There is no OpenSearch option on purpose.
# A knowledge base cannot change type: tear down before you change this.
KB_TYPE=managed

# Models. The defaults are Amazon models: no AWS Marketplace subscription and no
# Anthropic first-time-use form is needed for them.
GEN_MODEL_ID=amazon.nova-lite-v1:0
JUDGE_MODEL_ID=amazon.nova-pro-v1:0
# A judge from another model family, if you have completed Anthropic's first-time-use form:
# JUDGE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Only used when KB_TYPE=s3vectors.
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIMENSIONS=1024

# Passages retrieved per question (1 to 100).
TOP_K=5

# Contextual grounding guardrail thresholds, 0 to 0.99. An answer scoring below a
# threshold is blocked. Changing these needs a new guardrail: run 90_teardown.py first.
GROUNDING_THRESHOLD=0.7
RELEVANCE_THRESHOLD=0.7

# Corpus sample and the seed for sampling and question selection.
CORPUS_SAMPLE_SIZE=400
SEED=20261007

# Only if you choose a model that is not in kitlib/pricing.py: USD per 1,000,000 tokens,
# read from the Bedrock pricing page on the day you run.
# PRICE_GEN_INPUT_PER_1M=
# PRICE_GEN_OUTPUT_PER_1M=
# PRICE_JUDGE_INPUT_PER_1M=
# PRICE_JUDGE_OUTPUT_PER_1M=
