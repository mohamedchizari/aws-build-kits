# Copy to config.env and edit.
#
# REAL ENVIRONMENT VARIABLES WIN OVER THIS FILE. If your shell has exported
# AWS_REGION (many do), that value is used and the line below is ignored.
# Check with:  echo $AWS_REGION $KIT_PREFIX
# The kit records the Region, prefix and account of a deploy in .state.json and
# every later script stops if they no longer match, so a stray export cannot
# send teardown to the wrong Region. That protection needs the file: if
# .state.json is lost, teardown and the clean check work only in the Region
# and under the prefix set here, and say so.
#
# No secrets belong here: credentials come from your normal AWS sign-in
# (README section 3: aws configure sso, then aws sso login), never from this file.

# Region for everything the kit creates. Default us-east-1.
AWS_REGION=us-east-1

# Every resource name starts with this. 2 to 16 characters: lower-case letters,
# digits and hyphens, starting with a letter. Default kitdemo.
KIT_PREFIX=kitdemo

# The Bedrock model the agent calls. A model id or an inference profile id.
# Default: Amazon Nova Micro through the US geographic inference profile.
# Its model card (read 2026-10-07) lists it as Active, with tool use and the
# Converse API supported, usable from us-east-1, us-east-2 and us-west-2.
# If it handles the tool arguments badly, try us.amazon.nova-2-lite-v1:0
# (also confirmed for tool use on its model card). Token prices read 2026-10-07,
# per 1M tokens, us-east-1 / us-east-2 / us-west-2, for a plain model id or a
# us. inference profile: Nova Micro $0.035 in and $0.14 out; Nova 2 Lite $0.33
# in and $2.75 out. A global. inference profile has its own price: Nova 2 Lite
# $0.30 in and $2.50 out; the kit holds no global price for Nova Micro
# (README section 2 has the sources).
MODEL_ID=us.amazon.nova-micro-v1:0

# AgentCore Runtime platform version. Leave empty for the default, which AWS
# documents as V1. Set V2 for the snapshot-based runtime (different rates, see
# README section 2; your account and Region must have it enabled).
PLATFORM_VERSION=

# How long a hosted session may sit idle before AgentCore ends it, and the
# longest a session may live, in seconds. The service defaults are 900 and
# 28800. Short values keep a forgotten session cheap: at these settings a
# session that is never stopped costs at most about 6 cents (V1) or 10 cents
# (V2); at the service defaults the ceiling is about $2.04 or $3.12 a session
# (README section 2 shows the arithmetic). Minimum 60, maximum 28800.
IDLE_TIMEOUT_SECONDS=120
MAX_LIFETIME_SECONDS=900

# true: package aws-opentelemetry-distro and start the agent through
# opentelemetry-instrument, as the documented example does, so traces exist.
# false: plain start. Use false if the runtime fails to initialise.
ENABLE_OTEL=true

# Python runtime for the hosted agent: PYTHON_3_11, PYTHON_3_12 or PYTHON_3_13.
# Only PYTHON_3_13 has a lock file that pins every package in the zip; for the
# other two the indirect dependencies are resolved on the day you build.
PYTHON_RUNTIME=PYTHON_3_13

# Leave false. Two AWS pages disagree on whether the runtime's execution role
# needs S3 read access to the uploaded zip (README section 2). The kit follows
# the permissions page, which has none. If creating the runtime fails because
# it cannot read the package, set this to true, run 90_teardown.py, and deploy
# again: the role then gets s3:GetObject on that one object only.
EXECUTION_ROLE_S3_READ=false
